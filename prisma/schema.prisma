// Prisma Schema for YS CMS

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String    
  name           String?
  description    String?
  authorRole     String?
  profilePicture String?
  role           Role      @default(EDITOR)
  
  lastLogin      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  pages          Page[]    @relation("PageAuthor")
  blogs          Blog[]    @relation("BlogAuthor")
  blogRevisions  BlogRevision[] @relation("RevisionAuthor")
  refreshTokens  RefreshToken[]
}

model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  status    String   @default("draft")
  isTrashed Boolean  @default(false)
  content      Json
  draftContent Json?
  createdAt    DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  seo       SeoMeta?

  authorId  String?
  author    User?    @relation("PageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, isTrashed])
  @@index([isTrashed, updatedAt])
}

model SeoMeta {
  id            String   @id @default(cuid())
  metaTitle     String?
  metaDesc      String?
  focusKeyword  String?
  ogImage       String?
  ogTitle       String?
  ogDesc        String?
  canonicalUrl  String?
  structuredData Json?
  noIndex       Boolean  @default(false)
  authorName    String?
  authorRole    String?
  authorDescription String?
  
  pageId        String?  @unique
  page          Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  
  blogId        String?  @unique
  blog          Blog?    @relation(fields: [blogId], references: [id], onDelete: Cascade)
}

model Header {
  id        String   @id @default("global") 
  content   Json     
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Footer {
  id        String   @id @default("global") 
  content   Json     
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  featuredImage String?
  allowComments Boolean   @default(true)
  status        String    @default("draft")
  isTrashed     Boolean   @default(false)
  content       Json
  draftContent  Json?
  excerpt       String?
  readingTime   Int?     
  tags          String[] 
  categories    String[] 
  publishedAt   DateTime? 
  scheduledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  seo           SeoMeta?

  authorId      String?
  author        User?     @relation("BlogAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  
  comments      Comment[]
  revisions     BlogRevision[]
  categoryItems Category[]      @relation("BlogCategories")
  tagItems      Tag[]           @relation("BlogTags")
  
  notifyNewsletter Boolean              @default(false)
  newsletterSent   Boolean              @default(false)
  newsletterSentAt DateTime?
  campaigns        NewsletterCampaign[]

  @@index([status, isTrashed, scheduledAt, publishedAt])
}

model Category {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  description  String?
  metaTitle    String?
  metaDesc     String?
  focusKeyword String?
  ogImage      String?
  canonicalUrl String?
  noIndex      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  blogs        Blog[]   @relation("BlogCategories")

  @@index([slug])
}

model Tag {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  blogs       Blog[]   @relation("BlogTags")

  @@index([slug])
}

model Comment {
  id          String   @id @default(cuid())
  content     String
  isApproved  Boolean  @default(false)
  isTrashed   Boolean  @default(false)
  isAdmin     Boolean  @default(false)
  
  name        String
  email       String
  
  blogId      String
  blog        Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  
  parentId    String?
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[] @relation("CommentReplies")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([blogId, isApproved, isTrashed])
  @@index([isApproved, isTrashed])
}

model FormSubmission {
  id          String   @id @default(cuid())
  formName    String
  sourceUrl   String?
  payload     Json
  ipAddress   String?
  userAgent   String?
  isRead      Boolean  @default(false)
  isTrashed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([isTrashed, isRead, createdAt])
}

model Redirection {
  id             String   @id @default(cuid())
  sourceUrl      String   @unique
  destinationUrl String
  statusCode     Int      @default(301)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sourceUrl, status])
  @@index([status])
}

model RefreshToken {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([tokenHash])
}

model BlogRevision {
  id             String    @id @default(cuid())
  blogId         String
  blog           Blog      @relation(fields: [blogId], references: [id], onDelete: Cascade)
  versionNumber  Int
  snapshotData   Json
  action         String
  wordCount      Int       @default(0)
  readingTime    Int       @default(1)
  savedById      String?
  savedBy        User?     @relation("RevisionAuthor", fields: [savedById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@unique([blogId, versionNumber])
  @@index([blogId, createdAt(sort: Desc)])
}

// ==============================================================================
// NEWSLETTER & SUBSCRIBER MANAGEMENT
// ==============================================================================

enum SubscriberStatus {
  active
  unsubscribed
}

enum CampaignStatus {
  draft
  scheduled
  processing
  completed
  failed
}

enum CampaignType {
  BLOG_UPDATE
  CUSTOM_BLAST
}

model Subscriber {
  id               String           @id @default(cuid())
  email            String           @unique
  status           SubscriberStatus @default(active)
  unsubscribeToken String           @unique @default(cuid())
  source           String?          @default("website")
  
  resubscribedAt   DateTime?
  resubscribeCount Int              @default(0)

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, email])
  @@index([resubscribeCount])
}

model NewsletterCampaign {
  id              String         @id @default(cuid())
  subject         String
  bodyHtml        String         @db.Text
  type            CampaignType   @default(CUSTOM_BLAST)
  status          CampaignStatus @default(processing)
  scheduledAt     DateTime?
  
  blogId          String?
  blog            Blog?          @relation(fields: [blogId], references: [id], onDelete: SetNull)

  totalRecipients Int            @default(0)
  successCount    Int            @default(0)
  failedCount     Int            @default(0)
  errorMessage    String?        @db.Text

  createdAt       DateTime       @default(now())
  completedAt     DateTime?

  @@index([status, createdAt])
  @@index([status, scheduledAt])
}