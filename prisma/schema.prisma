// Prisma Schema for Zoro CMS

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String    
  name           String?
  description    String?
  authorRole     String?
  profilePicture String?
  role           Role      @default(EDITOR)
  
  lastLogin      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  pages          Page[]    @relation("PageAuthor")
  blogs          Blog[]    @relation("BlogAuthor")
}

model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  status    String   @default("draft")
  isTrashed Boolean  @default(false)
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  seo       SeoMeta?

  authorId  String?
  author    User?    @relation("PageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
}

model SeoMeta {
  id            String   @id @default(cuid())
  metaTitle     String?
  metaDesc      String?
  focusKeyword  String?
  ogImage       String?
  ogTitle       String?
  ogDesc        String?
  canonicalUrl  String?
  structuredData Json?
  noIndex       Boolean  @default(false)
  authorName    String?
  authorRole    String?
  authorDescription String?
  
  pageId        String?  @unique
  page          Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  
  blogId        String?  @unique
  blog          Blog?    @relation(fields: [blogId], references: [id], onDelete: Cascade)
}

model Header {
  id        String   @id @default("global") 
  content   Json     
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Footer {
  id        String   @id @default("global") 
  content   Json     
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  featuredImage String?
  allowComments Boolean   @default(true)
  status        String    @default("draft")
  isTrashed     Boolean   @default(false)
  content       Json
  excerpt       String?
  readingTime   Int?     
  tags          String[] 
  categories    String[] 
  publishedAt   DateTime? 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  seo           SeoMeta?

  authorId      String?
  author        User?     @relation("BlogAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  
  comments      Comment[]
}

model Comment {
  id          String   @id @default(cuid())
  content     String
  isApproved  Boolean  @default(false)
  isTrashed   Boolean  @default(false)
  
  name        String
  email       String
  
  blogId      String
  blog        Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  
  parentId    String?
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[] @relation("CommentReplies")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FormSubmission {
  id          String   @id @default(cuid())
  formName    String
  sourceUrl   String?
  payload     Json
  ipAddress   String?
  userAgent   String?
  isRead      Boolean  @default(false)
  isTrashed   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Redirection {
  id             String   @id @default(cuid())
  sourceUrl      String   @unique
  destinationUrl String
  statusCode     Int      @default(301)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sourceUrl, status])
}