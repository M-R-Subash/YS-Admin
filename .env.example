# ==============================================================================
# APPLICATION & SYSTEM METADATA
# ==============================================================================
NEXT_PUBLIC_APP_NAME="YS CMS Admin"
NEXT_PUBLIC_FRONTEND_URL="http://localhost:3001"

# ==============================================================================
# AUTHENTICATION & ACCESS CONTROL (NextAuth.js)
# ==============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-random-secret"

# Initial seed credentials for prisma db seed
ADMIN_SEED_EMAIL="admin@yourcompany.com"
ADMIN_SEED_PASSWORD="ChangeMeInProduction123!"

# ==============================================================================
# DATABASE (PostgreSQL / Supabase)
# ==============================================================================
# Local Postgres example:
DATABASE_URL="postgres://postgres:postgres@localhost:5432/zoro_cms?sslmode=disable"
DIRECT_URL="postgres://postgres:postgres@localhost:5432/zoro_cms?sslmode=disable"

# Production Supabase Pooler example (Port 6543):
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ==============================================================================
# CLOUDINARY CDN (Media Storage)
# ==============================================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-unsigned-upload-preset"
NEXT_PUBLIC_CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ==============================================================================
# SECURITY & CRYPTOGRAPHIC SECRETS
# ==============================================================================
# Shared handshake secret for iframe preview synchronization with main.ys
PREVIEW_SECRET="your-32-byte-hex-secret"
NEXT_PUBLIC_PREVIEW_SECRET="your-32-byte-hex-secret"

# Timing-safe token for ISR cache purging (/api/revalidate)
REVALIDATION_SECRET="your-32-byte-hex-secret"
