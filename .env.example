# ==============================================================================
# ENVIRONMENT & RUNTIME
# ==============================================================================
NODE_ENV=development
PORT=3000

# ==============================================================================
# APPLICATION & SYSTEM METADATA (Publicly Accessible)
# ==============================================================================
# Visible in browser titles, meta tags, and admin shell branding
NEXT_PUBLIC_APP_NAME="YS CMS Admin"
NEXT_PUBLIC_APP_DESCRIPTION="Enterprise Content Management System & Headless Studio"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Canonical URL of the consumer/frontend website (main.ys)
NEXT_PUBLIC_FRONTEND_URL="http://localhost:3001"

# ==============================================================================
# DATABASE (PostgreSQL / Supabase / Neon / RDS)
# ==============================================================================
# Transaction connection pooler (e.g., Supabase port 6543 with pgbouncer=true, or local Postgres)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/zoro_cms?sslmode=disable"

# Direct connection (port 5432) required for Prisma migrations and schema pushes
DIRECT_URL="postgres://postgres:postgres@localhost:5432/zoro_cms?sslmode=disable"

# Production Supabase Example:
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ==============================================================================
# AUTHENTICATION & SESSION LIFECYCLE (NextAuth.js)
# ==============================================================================
# Canonical URL of this admin panel
NEXTAUTH_URL="http://localhost:3000"

# Cryptographic encryption secret for session cookies (min 32 random characters)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-strong-random-secret-min-32-chars"

# Max session lifetime in seconds (default: 604800 = 7 days)
NEXTAUTH_MAX_AGE=604800

# Initial administrative seed credentials (used by prisma/seed.ts)
ADMIN_SEED_EMAIL="admin@yourcompany.com"
ADMIN_SEED_PASSWORD="ChangeMeInProduction123!"

# ==============================================================================
# JWT TOKEN EXPIRY & KEY POLICIES (Access & Refresh Tokens)
# ==============================================================================
# Optional independent JWT signing secret (falls back to NEXTAUTH_SECRET if blank)
JWT_SECRET="your_super_secret_jwt_key_change_in_production_min_32_chars"

# Sliding access token lifetime (e.g., 15m, 1h, 900s)
JWT_ACCESS_EXPIRY=15m

# Optional independent Refresh Token signing secret (falls back to NEXTAUTH_SECRET if blank)
JWT_REFRESH_SECRET="your_super_secret_refresh_key_change_in_production_min_32_chars"

# Refresh token sliding window lifetime (e.g., 7d, 30d, 604800s)
JWT_REFRESH_EXPIRY=7d

# ==============================================================================
# RATE LIMITING & THROTTLING (In-Memory Sliding Window / Edge Proxy)
# ==============================================================================
# Global API throttle time-to-live window in seconds
THROTTLE_TTL=60

# Maximum permitted requests per THROTTLE_TTL window
THROTTLE_LIMIT=1000

# Credential login brute-force window in seconds (default: 300 = 5 minutes)
RATE_LIMIT_LOGIN_WINDOW_SEC=300

# Maximum credential login attempts per IP per window before HTTP 429 lockout
RATE_LIMIT_LOGIN_MAX=10

# ==============================================================================
# MEDIA STORAGE (Cloudinary CDN)
# ==============================================================================
# Public cloud name & unsigned upload preset (safely exposed to browser for direct uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-unsigned-upload-preset"
NEXT_PUBLIC_CLOUDINARY_API_KEY="your-cloudinary-api-key"

# Private Cloudinary API secret (SERVER-ONLY - never expose to browser)
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ==============================================================================
# SECURITY & CRYPTOGRAPHIC HANDSHAKES
# ==============================================================================
# Shared handshake secret for iframe preview synchronization with main.ys
PREVIEW_SECRET="your-32-byte-hex-secret-min-32-chars"

# Timing-safe token for Next.js On-Demand ISR cache purging (/api/revalidate)
REVALIDATION_SECRET="your-32-byte-hex-secret-min-32-chars"

# ==============================================================================
# AUTOMATED SCHEDULED PUBLISHING (Cron Lifecycle)
# ==============================================================================
# Secret bearer token for authenticating scheduled publishing cron calls (/api/cron/publish-scheduled)
CRON_SECRET="your-strong-random-cron-secret-min-16-chars"

# Globally enable/disable background scheduled publishing (true | false)
CRON_ENABLED=true
